# Copy to .env and fill in real values. Never commit .env.
# Scripts load this via lib/load-dotenv.js

BASE_URL=http://localhost:4000

# --- Automation admin (userbot-style; post-commit-message, read-leadership-messages, make-admin-leader, etc.)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Bootstrap / first admin (think-style scripts: disable-cloud-features, register-admin-user, create-admin-complete)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_NAME=Admin User

# --- create-admin-user-first.js (login as bootstrap, create new admin)
# NEW_ADMIN_EMAIL=
# NEW_ADMIN_PASSWORD=

# --- register-and-make-admin.js (registration API)
# NEW_ADMIN_EMAIL=
# NEW_ADMIN_PASSWORD=
# NEW_ADMIN_USERNAME=adminuser
# NEW_ADMIN_NAME=Admin User

# --- check-admin-users.js and create-admin-user.js (API login)
SCRIPT_LOGIN_EMAIL=
SCRIPT_LOGIN_PASSWORD=

# --- create-admin-user.js (user to create or promote)
TARGET_ADMIN_EMAIL=
TARGET_ADMIN_PASSWORD=
# TARGET_ADMIN_USERNAME=   # optional; defaults to local-part of TARGET_ADMIN_EMAIL

# --- make-admin-leader-all-channels.js
TARGET_USER_EMAIL=

# --- make-user-admin.js (argv can override)
MAKE_ADMIN_USER_EMAIL=
PASSWORD=

# --- post-cpo-recommendations.js
CPO_EMAIL=
CPO_PASSWORD=

# --- set-user-bio.js (argv can override)
SECURITY_EMAIL=
SECURITY_PASSWORD=

# --- create-all-users.js — copy users.seed.json.example to users.seed.json and set real passwords
# USERS_SEED_JSON=./users.seed.json

# --- leadership-responses.js — copy leadership-users.seed.json.example to leadership-users.seed.json
# LEADERSHIP_USERS_JSON=./leadership-users.seed.json
# LEADERSHIP_CHANNEL_ID=
# LEADERSHIP_SEED_MESSAGE=optional override for demo message text

# --- read-leadership-messages.js
# LEADERSHIP_SOURCE_USERNAME=
# LEADERSHIP_DATA_PATH=./leadership-data.local.json

# --- create-admin-via-mongo.js / register flow
NEW_ADMIN_PLAIN_PASSWORD=

# --- test-post-message.js
RC_TEST_USERNAME=
RC_TEST_PASSWORD=

# --- reset-password.js (Mongo)
MONGO_URI_RESET=mongodb://localhost:27017/rocketchat?directConnection=true
RESET_TARGET_USERNAME=
RESET_NEW_PASSWORD=
